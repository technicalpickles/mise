#!/usr/bin/env bash
# Test that prebuilt binaries are not used when disabled (default behavior)

# Explicitly disable prebuilt binaries (this is the default)
mise settings set ruby.rv_prebuilt_binaries false

# Use a recent version that WOULD have prebuilt binaries available
VERSION="3.4.7"

# This test would be very slow if it actually compiled, so we'll just verify
# that the setting is respected by checking it doesn't mention prebuilt in early output
# We use a timeout to avoid waiting for full compilation

# Create a minimal test - just verify mise doesn't try to use prebuilt
# by checking ls-remote works (lightweight operation)
assert_succeed "mise ls-remote ruby@3"

# Verify the setting is actually false
assert "mise settings get ruby.rv_prebuilt_binaries" "false"
